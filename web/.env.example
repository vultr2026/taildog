# Build-time default fuse server URL (baked into the app bundle).
# Use the HTTPS URL (ngrok gives both http and https; https avoids mixed-content
# blocking in the Android WebView and on HTTPS-hosted web pages).
#
# The user can still override this in the app's Settings at runtime.
#
# Example:
#   VITE_FUSE_SERVER=https://xxxx-xxxx.ngrok-free.app
VITE_FUSE_SERVER=
